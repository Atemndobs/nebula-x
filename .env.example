# ===================================
# Supabase Configuration
# ===================================
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback

# ===================================
# GitHub OAuth Configuration
# ===================================
# 1. Create OAuth app: https://github.com/settings/developers
# 2. Set Homepage URL: http://localhost:5173
# 3. Set Authorization callback URL: http://localhost:5173/auth/callback
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret

# ===================================
# Google OAuth Configuration
# ===================================
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID
# 3. Add Authorized JavaScript origins: http://localhost:5173
# 4. Add Authorized redirect URIs: http://localhost:5173/auth/callback
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===================================
# App Configuration
# ===================================
NODE_ENV=development
VITE_APP_ENV=development